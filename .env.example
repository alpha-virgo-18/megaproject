# Copy this file to .env and fill in your own values. Never commit the real .env file.
# Appwrite endpoint, e.g. https://<region>.cloud.appwrite.io/v1 or your self-hosted URL
VITE_APPWRITE_URL=https://your-appwrite-endpoint/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COLLECTION_ID=your-posts-collection-id
VITE_APPWRITE_BUCKET_ID=your-storage-bucket-id
# TinyMCE Cloud API key. The editor falls back to a plain textarea when this is missing.
VITE_TINYMCE_API_KEY=your-tinymce-api-key
